{
  "name": "deal-or-default",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "sim": "tsx scripts/simulate.ts",
    "report": "tsx scripts/report.ts",
    "rooms:dev": "vite build && wrangler dev --port 8787",
    "deploy": "vite build && wrangler deploy",
    "rooms:smoke": "node scripts/room-smoke.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
